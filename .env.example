# SYNTRA Environment Configuration — Powered by ATLAS-MCP

# Application Server
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Primary Track: Model Context Protocol (ATLAS-MCP) Server
MCP_SERVER_NAME=syntra-atlas-mcp
MCP_SERVER_VERSION=1.0.0
MCP_PROTOCOL_VERSION=2024-11-05

# AWS Bedrock & S3 Configuration (AWS Builder Mini Challenge)
# If left empty, SYNTRA runs in high-fidelity deterministic simulation mode.
# When provided, SYNTRA invokes real Amazon Bedrock runtime models and archives incident metadata to real Amazon S3.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_S3_INCIDENT_BUCKET=syntra-incident-archives

# Ring Hardware Integration (Simulated vs Real)
# Set to 'true' for physical Ring OAuth/Webhook credentials; default is 'false' (high-fidelity local simulator)
ENABLE_REAL_RING_INTEGRATION=false
RING_REFRESH_TOKEN=

# Bee Wearable Context Integration
# Set to 'true' if genuine Bee Wearable CLI/device export is available; default is 'false' (timestamped fixture memories)
ENABLE_REAL_BEE_INTEGRATION=false
BEE_DEVICE_ID=
