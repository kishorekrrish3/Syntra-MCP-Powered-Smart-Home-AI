{
  "name": "syntra-atlas-mcp",
  "version": "1.0.0",
  "description": "SYNTRA: MCP-Powered Smart Home AI — Context-aware smart-home orchestration connecting IoT events, wearable memory, multimodal AI, and Fire TV through the Model Context Protocol.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:bridge": "npm --workspace=@atlas/mcp-iot-bridge run build",
    "test:bridge": "npm --workspace=@atlas/mcp-iot-bridge test"
  },
  "dependencies": {
    "@atlas/mcp-iot-bridge": "*",
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
